---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Histats from '../components/Histats.astro';
import { siteRoot, siteConfig, ogImage, ogImageAlt } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  bodyClass?: string;
  bare?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image = ogImage,
  imageAlt = ogImageAlt,
  noindex = false,
  schema = [],
  bodyClass = '',
  bare = false,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteRoot).href;
const jsonLd = schema.length
  ? JSON.stringify(schema.length === 1 ? schema[0] : schema).replace(/</g, '\\u003c')
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/main.js';
    </script>
    <Histats />
  </body>
</html>
