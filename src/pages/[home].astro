---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import SectionHead from '../components/SectionHead.astro';
import DownloadCard from '../components/DownloadCard.astro';
import FaqList from '../components/FaqList.astro';
import { sports, deviceRows, faqs } from '../lib/site';
import {
  siteConfig,
  homePath,
  homeUrl,
  homeDescription,
  ogImage,
  releaseLabel,
  apkFileName,
  publisher,
  releases,
  permissions,
} from '../lib/site';

export function getStaticPaths() {
  return [{ params: { home: siteConfig.homeSlug } }];
}

const { apk, brand, contactDisplay, appName } = siteConfig;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${homeUrl}#organization`,
  name: brand,
  url: siteConfig.siteUrl,
  description: publisher.note,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: contactDisplay,
    availableLanguage: 'English',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  name: brand,
  alternateName: appName,
  url: homeUrl,
  inLanguage: siteConfig.locale,
  publisher: { '@id': `${homeUrl}#organization` },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${homeUrl}#app`,
  name: brand,
  alternateName: appName,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: `Android ${apk.minAndroid}+`,
  softwareVersion: apk.version,
  softwareRequirements: `Android ${apk.minAndroid} (API ${apk.minApi}) or newer`,
  fileSize: `${apk.sizeBytes} bytes`,
  downloadUrl: apk.url,
  datePublished: apk.releaseDate,
  url: homeUrl,
  image: ogImage,
  description: homeDescription,
  publisher: { '@id': `${homeUrl}#organization` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${homeUrl}#faq`,
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout
  title={siteConfig.seoTitle}
  description={homeDescription}
  canonicalPath={homePath}
  schema={[organizationSchema, websiteSchema, softwareSchema, faqSchema]}
>
  <Hero />
  <Ticker />

  <section id="overview" class="section">
    <div class="wrap">
      <SectionHead
        num="01"
        title={`What ${appName} is`}
        lede="A compact Android app for watching live sport, with the file details, install steps, permissions and limits set out before you download."
      />
      <div class="overview">
        <p class="overview__lead">
          One APK, a small download, and a clear path from browser to home screen.
        </p>
        <div class="overview__copy">
          <p>
            {appName} is an Android app for watching live sport on phones, tablets and TV devices.
            It is distributed as a single APK rather than through an app store, which is why this
            page exists: to publish the file, list what it contains, and explain how to install it.
          </p>
          <p>
            The current release is version {apk.version}. It is {apk.sizeLabel}, supports Android
            {apk.minAndroid} and newer, and includes native libraries for {apk.architectures.count} CPU architectures. That
            covers most modern phones, tablets, TV boxes and emulators.
          </p>
          <p>
            {publisher.note} The APK here is the release we publish; the site itself does not host,
            store or transmit any video. File details and permissions are read from the current
            build and updated when the release changes.
          </p>
        </div>
      </div>

      <dl class="fact-strip">
        <div>
          <dt>APK size</dt>
          <dd>{apk.sizeLabel}</dd>
        </div>
        <div>
          <dt>Minimum Android</dt>
          <dd>{apk.minAndroid}+</dd>
        </div>
        <div>
          <dt>CPU support</dt>
          <dd>4 ABIs</dd>
        </div>
        <div>
          <dt>Current version</dt>
          <dd>{apk.version}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="sports" class="section">
    <div class="wrap">
      <SectionHead
        num="02"
        title="Sports coverage"
        lede="The app is organised around the sports below. A category being listed does not guarantee a specific match, channel or competition in your country."
      />
      <ul class="sport-grid">
        {
          sports.map((sport, index) => (
            <li>
              <span class="sport-grid__num">{String(index + 1).padStart(2, '0')}</span>
              <span>
                <span class="sport-grid__name">{sport.name}</span>
                <span class="sport-grid__desc">{sport.descriptor}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="sport-note">
        Schedules, competitions and availability change through the season and vary by region.
        Broadcast rights are usually sold territory by territory, so an event available in one
        country may be unavailable in another. This page does not provide streams or regional
        workarounds.
      </p>
    </div>
  </section>

  <DownloadCard />

  <section id="devices" class="section">
    <div class="wrap">
      <SectionHead
        num="04"
        title="Devices and compatibility"
        lede="One APK covers phones, tablets, TV boxes and emulators. Installation is the part that changes from device to device."
      />
      <div class="table-block">
        <table class="data-table">
          <caption class="sr-only">{appName} device compatibility</caption>
          <thead>
            <tr>
              <th scope="col">Device</th>
              <th scope="col">Support</th>
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              deviceRows.map((row) => (
                <tr>
                  <th scope="row" class="cell-device">{row.device}</th>
                  <td class="cell-support">
                    <span
                      class:list={[
                        'tag',
                        row.support === 'Supported' && 'tag--yes',
                        row.support === 'Not supported' && 'tag--no',
                      ]}
                    >
                      {row.support}
                    </span>
                  </td>
                  <td class="cell-note">{row.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Android TV and Fire TV usually require sideloading. Fire OS is based on Android but differs
        from Google-certified Android TV, so behaviour can vary by device and system version. Test
        the app on your own hardware before relying on it.
      </p>
    </div>
  </section>

  <section id="install" class="section">
    <div class="wrap">
      <SectionHead
        num="05"
        title="Install guide"
        lede="Four steps on a phone or tablet. Sideloading is allowed by Android, but it is switched off for each source until you enable it."
      />
      <ol class="steps">
        <li>
          <span class="steps__num">Step 01</span>
          <h3>Download the file</h3>
          <p>
            Use the APK button in section 03. The download is {apk.sizeLabel}, so it should be quick
            even on mobile data.
          </p>
        </li>
        <li>
          <span class="steps__num">Step 02</span>
          <h3>Allow the source</h3>
          <p>
            Android blocks APKs from browsers and file managers by default. When prompted, open
            Settings and allow installs from the app you are using. The permission applies only to
            that app.
          </p>
        </li>
        <li>
          <span class="steps__num">Step 03</span>
          <h3>Open and confirm</h3>
          <p>
            Find <strong>{apkFileName}</strong> in your Downloads folder, tap it, review
            the permissions shown, and choose Install.
          </p>
        </li>
        <li>
          <span class="steps__num">Step 04</span>
          <h3>Launch the app</h3>
          <p>
            Open {appName} from the app drawer. If Play Protect shows a warning for an app it does
            not recognise, read it before deciding whether to continue.
          </p>
        </li>
      </ol>

      <div class="callout">
        <h3>Android TV, Google TV and Fire TV</h3>
        <p>
          These devices usually need a sideloading tool. Install Downloader from the TV’s app store,
          allow installs from Downloader, then enter the download page address in its built-in
          browser and use the download button. The same APK works. A remote is enough to navigate,
          though a mouse helps with some system dialogs.
        </p>
      </div>
    </div>
  </section>

  <section id="version" class="section">
    <div class="wrap">
      <SectionHead
        num="06"
        title="Version and file details"
        lede="The numbers below describe the file linked on this page. They are useful when checking that a download finished correctly."
      />
      <dl class="version-grid">
        <div>
          <dt>Version</dt>
          <dd>{apk.version}</dd>
        </div>
        <div>
          <dt>File size</dt>
          <dd>{apk.sizeLabel}</dd>
        </div>
        <div>
          <dt>Minimum Android</dt>
          <dd>{apk.minAndroid} / API {apk.minApi}</dd>
        </div>
        <div>
          <dt>Package</dt>
          <dd>{apk.packageName}</dd>
        </div>
        <div>
          <dt>Released</dt>
          <dd>{releaseLabel}</dd>
        </div>
      </dl>
      <p class="table-note">
        <strong>Architectures:</strong> {apk.architectures}. These values were read from the published
        file and its manifest before this page was updated: versionName {apk.version}, minSdk {apk.minApi}, and
        {' '}{apk.sizeBytes.toLocaleString('en-GB')} bytes. A new release can appear at the download
        link at any time, so check the file details your browser shows before installing.
      </p>
      <p class="table-note">
        <a href="#permissions">See the full permission list</a> ·
        <a href="#releases">See the release notes</a>
      </p>
    </div>
  </section>

  <section id="permissions" class="section">
    <div class="wrap">
      <SectionHead
        num="07"
        title="App permissions"
        lede={`Every permission declared in the ${apk.version} manifest, with a plain description of what it allows. Android asks you to grant the sensitive ones during setup.`}
      />
      <div class="table-block">
        <table class="data-table">
          <caption class="sr-only">Permissions declared by {appName} {apk.version}</caption>
          <thead>
            <tr>
              <th scope="col">Permission</th>
              <th scope="col">What it allows</th>
            </tr>
          </thead>
          <tbody>
            {
              permissions.map((permission) => (
                <tr>
                  <th scope="row" class="cell-device">
                    <span class="permission-name">{permission.name}</span>
                  </th>
                  <td class="cell-note">{permission.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Disclaimer:</strong> This site publishes the VVStreams APK and explains how to
        install it. The other apps listed are independent projects; this page does not endorse
        or guarantee their safety or legality. Permissions and features can change between builds.
        Always verify the APK file name and size before installing, and use services you are
        entitled to access.
      </p>
      <p class="table-note">
        Permissions shown are from the current VVStreams manifest; other apps vary by build.
      </p>
    </div>
  </section>

  <section id="releases" class="section">
    <div class="wrap">
      <SectionHead
        num="08"
        title="Release notes"
        lede="The versions published so far, with the notes that accompanied each build."
      />
      <div class="table-block">
        <table class="data-table">
          <caption class="sr-only">{appName} release history</caption>
          <thead>
            <tr>
              <th scope="col">Version</th>
              <th scope="col">Date</th>
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              releases.map((release) => (
                <tr>
                  <th scope="row">{release.version}</th>
                  <td>{release.dateLabel}</td>
                  <td class="cell-note">{release.notes.join(' ')}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Only the current version is linked on this page. Older builds are listed so the version you
        already have can be identified, not offered for download.
      </p>
    </div>
  </section>

  <section id="guide" class="section">
    <div class="wrap">
      <SectionHead
        num="09"
        title="The longer guide"
        lede="What the app does, how to install it without surprises, and where its limits are."
      />
      <div class="article-layout">
        <article class="prose">
          <h3 id="what-it-is">What the app is built for</h3>
          <p>
            {appName} is aimed at people who follow several sports and want one Android app instead
            of a folder of bookmarks. The interface is organised around sports categories and opens
            live streams from inside the app. What is available varies by region and by the providers
            behind each stream.
          </p>
          <p>
            Because the app is installed from an APK rather than an app store, you are responsible
            for the install. That is not unusual on Android, especially for TV boxes and apps that
            are distributed outside an app store. It does mean the source of the file matters more
            than it would for a store download.
          </p>

          <h3 id="before-you-install">Before you install</h3>
          <p>Three checks take less than a minute and prevent most failed installs:</p>
          <ul>
            <li>
              <strong>Android version.</strong> You need Android {apk.minAndroid} (API {apk.minApi}) or newer.
              Older devices will refuse the package.
            </li>
            <li>
              <strong>Free storage.</strong> The download is {apk.sizeLabel}, but Android needs extra
              room while unpacking and installing. Keep at least a few hundred megabytes free.
            </li>
            <li>
              <strong>Install permission.</strong> The browser or file manager you use must be
              allowed to install unknown apps. This is a per-app setting, not a global switch.
            </li>
          </ul>

          <h3 id="safer-download">A safer way to download an APK</h3>
          <p>
            APK files sit outside app store review, so treat every download as untrusted until you
            have checked it. The{' '}
            <a href="#download">download section on this page</a> points to the file we publish.
            Your browser shows the file name before the transfer starts and its size as the download
            begins; both should match the details above.
          </p>
          <p>
            Be careful with pages that wrap an APK in an installer, add “mod” features, or ask you to
            complete a survey before the file appears. Those files are not the release referenced
            here. A familiar-looking logo is not proof that a build is genuine.
          </p>

          <h3 id="phone-install">Installing on a phone or tablet</h3>
          <ol>
            <li>Download the APK and wait for the browser to report that it has finished.</li>
            <li>Open the notification, or find the file in your Downloads folder.</li>
            <li>
              If Android blocks the install, choose Settings in the prompt, enable the source, then
              return to the file.
            </li>
            <li>Review the permissions listed, then tap Install.</li>
            <li>Open the app from the app drawer once the installer finishes.</li>
          </ol>
          <p>
            If you already have an older {appName} build, installing the new APK over it usually
            keeps your data. Android only allows that when the package name and signing identity
            match. If they do not, the installer will ask you to remove the old copy first.
          </p>

          <h3 id="tv-install">Installing on Android TV</h3>
          <p>
            TV devices hide the browser and file manager that phones take for granted. The simplest
            route is the Downloader app: install it from your TV’s app store, open its settings,
            allow installs from Downloader, then enter this page’s address in Downloader’s browser.
            The APK is the same file used on phones.
          </p>
          <p>
            A remote works for most of the interface. Some install dialogs are easier with a mouse
            or a remote that supports pointer mode. If the app opens in a phone-shaped window, check
            the display settings on the device before assuming the build is broken.
          </p>

          <h3 id="updates">Keeping the app updated</h3>
          <p>
            Sideloaded apps do not update automatically. When we publish a new version, download it
            from this page and install it over the existing copy. Watch for a package or signature
            mismatch: that usually means the new file was built with a different key, and Android
            will require a clean install.
          </p>
          <p>
            A clean install removes local settings and any saved preferences. If that matters, check
            whether the app offers a backup or export before you uninstall the old version.
          </p>

          <h3 id="troubleshooting">When something goes wrong</h3>
          <ul>
            <li>
              <strong>“App not installed.”</strong> Usually a signing mismatch, a full storage
              partition, or a managed device policy. Uninstall the old copy only if you accept losing
              its data.
            </li>
            <li>
              <strong>“Parse error.”</strong> The download is incomplete or corrupted. Delete it and
              download again; do not try to repair the file.
            </li>
            <li>
              <strong>Play Protect warning.</strong> This is Android’s reputation check for apps it
              has not seen before. Read the message. Do not disable protections permanently just to
              get one app installed.
            </li>
            <li>
              <strong>No picture or constant buffering.</strong> That is a playback or network issue,
              not something this page can fix. Check your connection, the source, and the device’s
              available memory.
            </li>
            <li>
              <strong>The remote cannot reach a button.</strong> Enable pointer mode on the remote,
              or connect a USB mouse for the setup screens.
            </li>
          </ul>

          <h3 id="limits">What this page does not do</h3>
          <blockquote>
            This page does not host video, sell subscriptions, or provide regional workarounds. It
            publishes the APK and explains how to install it.
          </blockquote>
          <p>
            It is a download and setup resource, not a broadcaster. Sports rights are territorial and
            change over time, so availability inside the app depends on the providers behind each
            stream and on the country you are in. Use the app only where you are entitled to watch
            what it opens, and follow the terms that apply.
          </p>
        </article>

        <aside class="article-aside" aria-label="In this guide">
          <h3>In this guide</h3>
          <ol>
            <li><a href="#what-it-is">What the app is built for</a></li>
            <li><a href="#before-you-install">Before you install</a></li>
            <li><a href="#safer-download">A safer way to download</a></li>
            <li><a href="#phone-install">Installing on a phone</a></li>
            <li><a href="#tv-install">Installing on Android TV</a></li>
            <li><a href="#updates">Keeping the app updated</a></li>
            <li><a href="#troubleshooting">When something goes wrong</a></li>
            <li><a href="#limits">What this page does not do</a></li>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="wrap">
      <SectionHead
        num="10"
        title="Frequently asked questions"
        lede="Short answers about the file, the supported devices, the permissions, and what happens after installation."
      />
      <FaqList />
    </div>
  </section>

  <section id="alternatives" class="section">
    <div class="wrap">
      <SectionHead
        num="12"
        title="App comparisons"
        lede="How VVStreams compares with other popular Android streaming apps. Note: this site does not host streams; the APK linked here is our own published release."
      />
      <p>
        The following comparison table lists key details for apps that people commonly
        search for when looking to watch live sports on Android. All data is taken from
        publicly available information (app listings, manifest reads, release notes).
        Permissions and capabilities vary by build; always check the APK your device shows.
      </p>
      <div class="table-block">
        <table class="data-table" style="table-layout: fixed;">
          <caption class="sr-only">Comparison of streaming apps</caption>
          <thead>
            <tr>
              <th scope="col" style="width: 14.28%;">Feature</th>
              <th scope="col" style="width: 14.28%;">VVStreams</th>
              <th scope="col" style="width: 14.28%;">HDstreamz</th>
              <th scope="col" style="width: 14.28%;">Sportsurge</th>
              <th scope="col" style="width: 14.28%;">Hesgoal</th>
              <th scope="col" style="width: 14.28%;">Totalsportek</th>
              <th scope="col" style="width: 14.28%;">Streameast</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" style="width: 14.28%;">App size</th>
              <td style="width: 14.28%;">{apk.sizeLabel}</td>
              <td style="width: 14.28%;">~5–8 MB (varies by build)</td>
              <td style="width: 14.28%;">~5–7 MB (varies by build)</td>
              <td style="width: 14.28%;">~5 MB (varies by build)</td>
              <td style="width: 14.28%;">~6 MB (varies by build)</td>
              <td style="width: 14.28%;">~5 MB (varies by build)</td>
            </tr>
            <tr>
              <th scope="row" style="width: 14.28%;">Minimum Android</th>
              <td style="width: 14.28%;">{apk.minAndroid}+</td>
              <td style="width: 14.28%;">4.1+</td>
              <td style="width: 14.28%;">4.0+</td>
              <td style="width: 14.28%;">4.0+</td>
              <td style="width: 14.28%;">4.0+</td>
              <td style="width: 14.28%;">4.1+</td>
            </tr>
            <tr>
              <th scope="row" style="width: 14.28%;">API level</th>
              <td style="width: 14.28%;">API {apk.minApi}+</td>
              <td style="width: 14.28%;">~16+</td>
              <td style="width: 14.28%;">~15+</td>
              <td style="width: 14.28%;">~15+</td>
              <td style="width: 14.28%;">~15+</td>
              <td style="width: 14.28%;">~16+</td>
            </tr>
            <tr>
              <th scope="row" style="width: 14.28%;">Distribution</th>
              <td style="width: 14.28%;">External host (this site)</td>
              <td style="width: 14.28%;">Third‑party site</td>
              <td style="width: 14.28%;">Third‑party site</td>
              <td style="width: 14.28%;">Third‑party site</td>
              <td style="width: 14.28%;">Third‑party site</td>
              <td style="width: 14.28%;">Third‑party site</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Disclaimer:</strong> This site publishes the VVStreams APK and explains how to
        install it. The other apps listed are independent projects; this page does not endorse
        or guarantee their safety or legality. Permissions and features can change between builds.
        Always verify the APK file name and size before installing, and use services you are
        entitled to access.
      </p>
    </div>
  </section>

  <section id="rights" class="section">
    <div class="wrap">
      <SectionHead
        num="11"
        title="Content rights and safety"
        lede="Two separate issues: what you are allowed to watch, and how to install the file without taking unnecessary risks."
      />
      <div class="card-grid">
        <div class="card card--accent">
          <h3>Content and rights</h3>
          <p>
            This page does not host, store or transmit video. {appName} is published as an APK, and
            what plays inside it comes from the sources the app opens. Broadcast rights are
            territorial and change over time.
          </p>
          <p>
            Use the app only for content you are entitled to access, and follow the terms of the
            services you use. Nothing on this page grants a licence to any match, channel or feed.
          </p>
        </div>
        <div class="card card--accent">
          <h3>Installing safely</h3>
          <ul>
            <li>Download only from the file linked on this page.</li>
            <li>Compare the file name and size with the details above.</li>
            <li>Review the permissions Android lists before installing.</li>
            <li>Scan the file with your own security software if you are unsure.</li>
            <li>Avoid modified or “patched” builds from unknown sites.</li>
          </ul>
          <p class="card__tail">
            If you are not comfortable sideloading an APK, this is not the right install method for
            you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="wrap">
      <SectionHead
        num="12"
        title="About this page"
        lede="Who runs the site, what was checked, and how to report a problem."
      />
      <div class="about-grid">
        <div>
          <p>
            {publisher.note} {brand} publishes the {appName} APK and its release notes on this page.
            The site is not affiliated with, endorsed by or sponsored by any league, team,
            broadcaster or streaming service.
          </p>
          <p>
            The file details, permissions and release notes on this page are read from the published
            APK and reviewed again with each release. There are no ads or sponsored placements on the
            site. Rights complaints are handled through the <a href="/dmca/">takedown page</a>.
          </p>
          <p>
            Page last reviewed: {releaseLabel}. For the current file, use the download section on
            this page rather than a copy hosted somewhere else; other sites may repackage the APK.
          </p>
        </div>
        <div class="contact-block">
          <dl>
            <dt>Site contact</dt>
            <dd><a href={homeUrl}>{contactDisplay}</a></dd>
          </dl>
          <p>Selecting the address returns to the homepage. This page does not run a contact form.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
