---
import { siteConfig, releaseLabel, siteHost } from '../lib/site';

const { apk, appName } = siteConfig;
const facts = [
  ['Version', apk.version],
  ['File type', 'APK'],
  ['File size', apk.sizeLabel],
  ['Minimum Android', `${apk.minAndroid} (API ${apk.minApi})`],
  ['Package', apk.packageName],
  ['Released', releaseLabel],
];
---

<section id="download" class="section section--dark" aria-labelledby="download-title">
  <div class="wrap">
    <div class="download-panel">
      <div>
        <p class="download-panel__label">03 / Direct download</p>
        <h2 id="download-title">Download<br />{appName} APK</h2>
        <p class="download-panel__copy">
          Version <strong>{apk.version}</strong>, published {releaseLabel}. The button opens the
          {apk.sizeLabel} APK file on our download host.
        </p>
        <div class="download-actions">
          <a class="btn btn--primary" href={apk.url}>
            Download {appName} {apk.version} APK
            <span class="btn__arrow" aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="download-hint">
          <strong>{apk.sizeLabel}</strong> · Android {apk.minAndroid}+ · {apk.architectures}
        </p>
      </div>

      <dl class="download-facts" aria-label="APK details">
        {facts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>

      <p class="download-panel__note">
        <strong>Before you continue:</strong> we publish this release; the file itself is served by
        an external download host, not from {siteHost}. Check that the file name ends in
        <strong>.apk</strong> and that the size matches <strong>{apk.sizeLabel}</strong>. If
        something is wrong with the download, <a href="/contact/">tell us</a>.
      </p>
    </div>
  </div>
</section>
