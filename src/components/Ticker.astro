---
import { sports } from '../lib/site';
---

<div class="ticker" role="region" aria-label="Sports coverage">
  <div class="ticker__track">
    {
      [0, 1].map((copy) => (
        <div class="ticker__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {sports.map((sport) => (
            <span class="ticker__item">
              {sport.name}
              <span>{sport.descriptor}</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
