---
import { siteConfig, homePath } from '../lib/site';

const { histatsEnabled: enabled, histatsId } = siteConfig.analytics;
---

{
  enabled && (
    <>
      <script is:inline define:vars={{ histatsId }}>
        var _Hasync = _Hasync || [];
        _Hasync.push(['Histats.start', '1,' + histatsId + ',4,0,0,0,00010000']);
        _Hasync.push(['Histats.fasi', '1']);
        _Hasync.push(['Histats.track_hits', '']);
        (function () {
          var hs = document.createElement('script');
          hs.type = 'text/javascript';
          hs.async = true;
          hs.src = '//s10.histats.com/js15_as.js';
          (
            document.getElementsByTagName('head')[0] ||
            document.getElementsByTagName('body')[0]
          ).appendChild(hs);
        })();
      </script>
      <noscript>
        <a href={homePath} target="_blank" rel="noopener">
          <img
            src={`//sstatic1.histats.com/0.gif?${histatsId}&101`}
            alt="free site statistics"
            border="0"
          />
        </a>
      </noscript>
    </>
  )
}